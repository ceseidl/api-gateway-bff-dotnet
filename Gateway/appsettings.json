{
  "ReverseProxy": {
    "Routes": {
      "mobile": {
        "ClusterId": "mobile-bff",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/mobile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/mobile"
          },
          {
            "RequestHeader": "X-Client",
            "Set": "mobile-app"
          },
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "web": {
        "ClusterId": "web-bff",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/web/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/web"
          }
        ]
      }
    },
    "Clusters": {
      "mobile-bff": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://mobile-bff-1:8080/"
          },
          "d2": {
            "Address": "http://mobile-bff-2:8080/"
          }
        }
      },
      "web-bff": {
        "Destinations": {
          "d1": {
            "Address": "http://web-bff:8080/"
          }
        }
      }
    }
  }
}
